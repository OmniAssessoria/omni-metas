{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "bundler",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client"],

    "rootDir": "src",
    "outDir": "dist",

    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "vite.config.ts"]
}
