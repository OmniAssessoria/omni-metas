{
  "name": "web_base",
  "private": true,
  "workspaces": [
    "subprojetos/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @web_base/webapi\" \"npm run dev --workspace @web_base/webapp\"",
    "dev:api": "npm run dev --workspace @web_base/webapi",
    "dev:app": "npm run dev --workspace @web_base/webapp",
    "build": "npm run build -workspaces"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/puppeteer": "^5.4.7",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "puppeteer": "^24.40.0"
  }
}
