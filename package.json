{
  "name": "web_base",
  "private": true,
  "workspaces": [
    "subprojetos/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @web_base/webapi\" \"npm run dev --workspace @web_base/webapp\"",
    "dev:api": "npm run dev --workspace @web_base/webapi",
    "dev:app": "npm run dev --workspace @web_base/webapp",
    "build": "npm run build -workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
