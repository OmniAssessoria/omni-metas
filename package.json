{
  "name": "web_base",
  "private": true,
  "workspaces": [
    "subprojetos/*"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' concurrently \"npm run dev --workspace @web_base/webapi\" \"npm run dev --workspace @web_base/webapp\"",
    "dev:api": "npm run dev --workspace @web_base/webapi",
    "dev:app": "npm run dev --workspace @web_base/webapp",
    "build": "npm run build -workspaces"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/connect": "^3.4.38",
    "@types/form-data": "^2.2.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.6.0",
    "@types/puppeteer": "^5.4.7",
    "@types/trusted-types": "^2.0.7",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "multer": "^2.4.0",
    "puppeteer": "^24.43.1",
    "xlsx": "^0.20.1"
  }
}
